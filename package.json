{
  "name": "claudewatch",
  "version": "0.1.0",
  "description": "Anthropic token usage monitor — daemon, CLI, and web dashboard",
  "type": "module",
  "bin": {
    "claudewatch": "./bin/claudewatch.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config src/web/vite.config.ts",
    "check:runtime": "node scripts/check-runtime-compat.mjs",
    "dev": "tsx watch src/cli/index.ts",
    "daemon": "tsx src/daemon/index.ts",
    "web": "vite src/web",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:extension": "npm --prefix claudewatch-extension run validate",
    "smoke": "npm run build && node dist/cli/index.js --help && npm run validate:extension",
    "check": "npm run check:runtime && npm run lint && npm run typecheck && npm test && npm run test:coverage && npm run smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@inquirer/prompts": "^8.7.2",
    "better-sqlite3": "^9.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "ink": "^5.1.0",
    "keytar": "^7.9.0",
    "node-cron": "^4.6.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^10.0.14",
    "open": "^11.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@yao-pkg/pkg": "^6.23.0",
    "eslint": "^10.12.0",
    "semver": "^7.7.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "^11.1.1"
    }
  }
}
