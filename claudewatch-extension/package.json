{
  "name": "token-watcher-extension",
  "version": "0.12.0",
  "description": "Token Watcher — AI token usage monitoring for Claude, ChatGPT, and Gemini",
  "private": true,
  "scripts": {
    "validate": "node validate-manifest.js",
    "zip": "npm run validate && zip -r ../token-watcher-extension.zip . --exclude '*.git*' --exclude 'node_modules/*' --exclude 'package*.json' --exclude 'validate-manifest.js' --exclude '*.zip' --exclude 'test/*' --exclude 'lib/*'"
  }
}
