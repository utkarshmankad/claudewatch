{
  "schemaVersion": 1,
  "generatedFrom": "claudewatch-extension/analytics.js (EVENT_DEFINITIONS); a test keeps this file in sync",
  "retention": {
    "maxAgeDays": 90,
    "maxEvents": 5000
  },
  "events": {
    "installed": {
      "description": "Extension installed.",
      "props": {}
    },
    "onboarding_completed": {
      "description": "User finished the onboarding page.",
      "props": {}
    },
    "provider_connected": {
      "description": "First provider-reported snapshot saved for a provider.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ]
      }
    },
    "first_useful_reading": {
      "description": "First trustworthy provider-reported quota reading after install.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ],
        "secondsSinceInstall": {
          "type": "int",
          "min": 0,
          "max": 31536000
        }
      }
    },
    "first_recommendation": {
      "description": "First recommendation (plan or provider switch) shown to the user.",
      "props": {
        "kind": [
          "plan",
          "provider_switch",
          "wait",
          "other"
        ]
      }
    },
    "refresh_result": {
      "description": "One provider refresh attempt finished.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ],
        "ok": "bool",
        "errorCategory": [
          "none",
          "provider_tab_missing",
          "provider_tab_timeout",
          "auth_expired",
          "rate_limited",
          "provider_schema_changed",
          "network",
          "timeout",
          "other"
        ],
        "trigger": [
          "install",
          "startup",
          "alarm",
          "tab",
          "focus",
          "wake",
          "manual",
          "other"
        ],
        "durationMs": {
          "type": "int",
          "min": 0,
          "max": 600000
        }
      }
    },
    "stale_started": {
      "description": "A provider reading crossed the stale threshold.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ],
        "reason": [
          "none",
          "provider_tab_missing",
          "provider_tab_timeout",
          "auth_expired",
          "rate_limited",
          "provider_schema_changed",
          "network",
          "timeout",
          "other"
        ],
        "explained": "bool"
      }
    },
    "stale_ended": {
      "description": "A stale provider reading was refreshed.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ],
        "staleSeconds": {
          "type": "int",
          "min": 0,
          "max": 31536000
        },
        "explained": "bool"
      }
    },
    "attribution_measured": {
      "description": "Attribution coverage sample (emitted from Phase 1 reconciliation).",
      "props": {
        "attributedUnits": {
          "type": "int",
          "min": 0,
          "max": 1000000
        },
        "eligibleUnits": {
          "type": "int",
          "min": 0,
          "max": 1000000
        }
      }
    },
    "alert_shown": {
      "description": "A quota-risk alert was shown.",
      "props": {
        "level": [
          "warn",
          "high",
          "critical"
        ],
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ]
      }
    },
    "alert_action": {
      "description": "User acted on an alert.",
      "props": {
        "action": [
          "switch_provider",
          "wait",
          "plan_action",
          "dismiss"
        ],
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ]
      }
    },
    "report_shared": {
      "description": "User exported or shared a usage report.",
      "props": {
        "channel": [
          "copy",
          "download",
          "link"
        ]
      }
    },
    "recommendation_impression": {
      "description": "Autopilot showed a recommendation (at most once per distinct recommendation per six hours).",
      "props": {
        "action": [
          "use",
          "wait"
        ],
        "provider": [
          "claude",
          "chatgpt",
          "gemini",
          "none"
        ],
        "confidence": [
          "high",
          "medium",
          "low"
        ],
        "state": [
          "ready",
          "stale",
          "all_limited"
        ]
      }
    },
    "explanation_viewed": {
      "description": "User opened the Autopilot \"why\" explanation.",
      "props": {
        "action": [
          "use",
          "wait"
        ]
      }
    },
    "provider_opened": {
      "description": "User pressed Open provider from Autopilot.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini"
        ],
        "source": [
          "primary",
          "alternative"
        ]
      }
    },
    "wait_chosen": {
      "description": "User chose to wait for a reset when all providers were limited.",
      "props": {
        "provider": [
          "claude",
          "chatgpt",
          "gemini",
          "none"
        ]
      }
    },
    "recommendation_dismissed": {
      "description": "User dismissed the current Autopilot recommendation.",
      "props": {
        "action": [
          "use",
          "wait"
        ]
      }
    },
    "preference_changed": {
      "description": "User changed an Autopilot preference.",
      "props": {
        "setting": [
          "task",
          "reserved",
          "working_hours",
          "notification_frequency",
          "pinned",
          "excluded"
        ]
      }
    },
    "autopilot_toggled": {
      "description": "User turned Autopilot recommendations on or off.",
      "props": {
        "enabled": "bool"
      }
    },
    "autopilot_alert_shown": {
      "description": "An Autopilot or experiment-arm notification was shown.",
      "props": {
        "kind": [
          "action_changed",
          "block_likely",
          "reset_approaching",
          "plan_review",
          "threshold"
        ],
        "arm": [
          "threshold",
          "autopilot"
        ]
      }
    },
    "autopilot_alert_action": {
      "description": "User acted on a notification within the attribution window.",
      "props": {
        "action": [
          "switch_provider",
          "wait",
          "plan_action",
          "dismiss"
        ],
        "kind": [
          "action_changed",
          "block_likely",
          "reset_approaching",
          "plan_review",
          "threshold"
        ]
      }
    },
    "alert_feedback": {
      "description": "User rated a notification from the history.",
      "props": {
        "verdict": [
          "useful",
          "false_positive"
        ]
      }
    },
    "experiment_assigned": {
      "description": "Local alert experiment arm assigned after opt-in.",
      "props": {
        "arm": [
          "threshold",
          "autopilot"
        ]
      }
    },
    "active_day": {
      "description": "Extension surface opened; at most one per local day.",
      "props": {
        "surface": [
          "popup",
          "settings",
          "onboarding"
        ]
      }
    }
  }
}
